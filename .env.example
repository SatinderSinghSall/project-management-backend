#Inngest
INNGEST_EVENT_KEY="--------inngest_event_key--------"
INNGEST_SIGNING_KEY="--------inngest_signing_key--------"

# SMTP Credentials Nodemailer
NODEMAILER_EMAIL=------add_email-------
NODEMAILER_PASSWORD=------add_app_password------

# Admin Credentials
ADMIN_USER_IDS=------add-user-id------
ADMIN_APP_ORIGIN=http://localhost:5174

# Existing Frontend Origin
CLIENT_URL=http://localhost:5173
