# Run Environment

NODE_ENV = "development" #Change to "production" in deployment

# Clerk
CLERK_PUBLISHABLE_KEY="--------clerk_publishable_key--------"
CLERK_SECRET_KEY="--------clerk_secret_key--------"

# Neon Database
DATABASE_URL = "--------database_url_pooler--------"
